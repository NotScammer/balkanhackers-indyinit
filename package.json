    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "robots-parser": "^3.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
