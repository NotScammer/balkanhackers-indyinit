# Supabase project settings: API URL and server service_role key (never NEXT_PUBLIC).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Settings/API: publishable key (legacy anon key also works here), used only for Auth.
SUPABASE_PUBLISHABLE_KEY=
# Exact application origin, no path. Use the deployed HTTPS origin on Vercel.
APP_URL=http://localhost:3000
# Claude Console. Set a supported model ID with structured output support.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# OpenAI project API key. Choose supported Realtime and transcription model IDs.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
# Tavily dashboard; optional industry search. OpenAlex developer settings; optional academic branch.
TAVILY_API_KEY=
OPENALEX_API_KEY=
# SerpApi dashboard: monthly Google Trends interest-over-time lookups; never used during interviews.
SERPAPI_API_KEY=
# Empty means worldwide; optionally use a Google Trends country/subregion such as US.
GOOGLE_TRENDS_GEO=
# Generate two independent secrets with: openssl rand -hex 32
CRON_SECRET=
RATE_LIMIT_SALT=
# Never silently use synthetic research. Seed illustrative data explicitly before enabling this.
RESEARCH_DATA_MODE=verified
RESEARCH_CONTACT_EMAIL=
RESEARCH_DEADLINE_SECONDS=210
SESSION_DAILY_LIMIT=100

OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
